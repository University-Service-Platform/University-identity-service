# Copy to .env (never commit .env) and adjust for your environment.

# development | test | production
ENVIRONMENT=development

# SQLAlchemy database URL owned exclusively by the Identity Service
DATABASE_URL=sqlite:///./identity.db

# JWT signing
JWT_ALGORITHM=HS256
# Required when ENVIRONMENT=production (the development default is rejected)
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
