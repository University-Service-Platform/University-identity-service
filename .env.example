# Copy to .env (never commit .env) and adjust for your environment.

# development | test | production
ENVIRONMENT=development

# SQLAlchemy database URL owned exclusively by the Identity Service
DATABASE_URL=sqlite:///./identity.db

# ---- JWT ----
# RS256 (default): tokens are signed with the private key; other services verify them
# with the public key published at /.well-known/jwks.json.
# Generate keys with: python scripts/generate_jwt_keys.py
# In development, an ephemeral key pair is generated when the paths are empty.
# Required when ENVIRONMENT=production.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# Only used when JWT_ALGORITHM=HS256 (the development default is rejected in production)
JWT_SECRET_KEY=change-me
JWT_ISSUER=university-identity-service
JWT_AUDIENCE=university-services-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Directory Service (Group 5, owns faculties/departments/service units/affiliations) ----
# Leave empty to disable; features that need directory data then return 503.
DIRECTORY_SERVICE_BASE_URL=http://localhost:8002
DIRECTORY_SERVICE_TIMEOUT_SECONDS=3

# ---- HTTP ----
# Browser origins allowed to call the service directly (comma-separated), e.g. the shared
# frontend's dev server. Leave empty when all browser traffic goes through the API Gateway.
# '*' is rejected when ENVIRONMENT=production.
CORS_ALLOWED_ORIGINS=
# Prefix the API Gateway strips before forwarding (e.g. /identity), so Swagger UI works at
# {gateway}/identity/docs. Leave empty when the service is called directly.
ROOT_PATH=

# Password given to synthetic demo users by `python -m app.seed --demo`
DEMO_USER_PASSWORD=change-me-demo-password

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
