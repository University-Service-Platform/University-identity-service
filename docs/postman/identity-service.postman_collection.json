            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ADM001\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test('uses the standard envelope', () => pm.expect(pm.response.json()).to.have.property('success'));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.test('token issued', () => pm.expect(data.access_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
